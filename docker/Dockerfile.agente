# Imagem de DESENVOLVIMENTO da stack local por agente (docker-compose.agente.yml).
# Não é a imagem de produção (apps/api/Dockerfile e apps/web/Dockerfile): aqui entram as
# dependências de desenvolvimento do monorepo inteiro, e o código vem montado da worktree, então
# editar o código não exige reconstruir nada.
FROM node:22-alpine

# openssl é exigido pelo motor do Prisma; python3, make e g++ compilam módulos nativos (sharp,
# argon2) quando não há binário pronto.
RUN apk add --no-cache openssl python3 make g++

WORKDIR /app
# o npm ci de um monorepo precisa do package.json de cada pacote no lugar certo
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
# --ignore-scripts: o postinstall da raiz compila o packages/shared e o da API roda o
# `prisma generate`, e ambos precisam do código, que só chega montado, em tempo de execução.
# O scripts/agente-stack.conf.sh roda esses dois passos antes de subir e de testar.
# O `npm rebuild @prisma/engines` prepara os binários do Prisma, que o --ignore-scripts pulou e que
# o `prisma generate` do tempo de execução não conseguiria gravar (node_modules é do root).
RUN npm ci --ignore-scripts && npm rebuild @prisma/engines
