# Copie para .env. Jest e Playwright leem .env.teste (criado a partir deste arquivo).
DATABASE_URL=postgresql://desbravador:desbravador@localhost:5442/desbravador
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5442/postgres
PORTA_API=3001
APP_URL=http://localhost:5173
# Gere com: openssl rand -hex 32
JWT_SEGREDO=troque-por-openssl-rand-hex-32
COOKIE_SECURE=false
# Saltos de proxy confiaveis (prod: 2)
TRUST_PROXY=0
SMTP_HOST=localhost
SMTP_PORTA=1026
SMTP_USUARIO=
SMTP_SENHA=
SMTP_FROM=Desbravadores <nao-responda@desbravadores.local>
MAILPIT_URL=http://localhost:8026
# Vazio = usa o padrao do repositorio
CARGA_DIR=
WEB_PORTA=8090
BACKUP_AGE_DESTINATARIO=age1chavedeteste
RCLONE_REMOTO=./backups
